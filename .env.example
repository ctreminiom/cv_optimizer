# ─── Required ─────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com/settings/keys
# NOTE: a Claude.ai Pro/Max subscription does NOT include API credits.
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# ─── Models (override per environment) ────────────────────────────────────
MODEL_HAIKU=claude-haiku-4-5-20251001
MODEL_SONNET=claude-sonnet-4-6

# ─── Default execution mode ───────────────────────────────────────────────
DEFAULT_MODE=auto

# ─── Optional — search subcommand providers ──────────────────────────────
# Either is enough; deep-link fallbacks always work without these.
# TAVILY_API_KEY=tvly-xxxxxxxx                    # https://tavily.com (free tier)
# SERPER_API_KEY=xxxxxxxxxxxxxxxxxxxx             # https://serper.dev (free tier)

# ─── Optional — spend cap (USD per run) ───────────────────────────────────
# SPEND_LIMIT_USD=

# ─── CrewAI memory (A5 — opt-in) ──────────────────────────────────────────
# Set to 1 to enable CrewAI's short/long-term/entity memory across agents.
# CREW_MEMORY=1
# Embedder backend for memory + knowledge sources. Local is key-free.
# CREW_EMBEDDER_PROVIDER=huggingface           # huggingface (default) | openai | voyage
# CREW_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── Observability (B1 — both off by default) ─────────────────────────────
# CREWAI_TRACING=1                             # run `crewai login` once first
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Logging (B2) ─────────────────────────────────────────────────────────
# LOG_LEVEL=INFO                                # DEBUG | INFO | WARNING | ERROR
